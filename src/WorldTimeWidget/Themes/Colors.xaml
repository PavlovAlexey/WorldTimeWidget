<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Начиная с v1.3 (система тем оформления, см. spec.md «Доработка v1.3») все цветовые токены,
        которые зависят от темы — поверхность карточки/попапов, обводка, home-highlight, текст,
        разделитель, тень — БОЛЬШЕ НЕ статические ресурсы здесь: они переехали в bindable-кисти
        ThemeViewModel (см. ViewModels/ThemeViewModel.cs), доступные из XAML как
        "{Binding Theme.XXX}" (MainViewModel.Theme, проброшенный тем же именем в дочерние
        view-model строк/результатов поиска). Здесь остаются только токены, НЕ зависящие от темы
        (см. design_brief.md и ThemeCatalogService — dayDot/nightDot одинаковые во всех темах,
        accent не входит в список токенов тем).
    -->

    <!-- Подсветка строки при наведении/нажатии (не тема-зависимая) -->
    <SolidColorBrush x:Key="SurfaceRowHoverBrush" Color="#14000000"/>

    <!-- Акцент — единый во всех темах (не входит в список токенов темы) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F0006CBE"/>

    <!-- Текст на акцентной подложке (тумблеры, thumb слайдера) -->
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

    <!-- Индикатор день/ночь -->
    <SolidColorBrush x:Key="DayDotBrush" Color="#FFB900"/>
    <SolidColorBrush x:Key="NightDotBrush" Color="#5B5FC7"/>

    <!-- Danger (пункт "Выход") -->
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerHoverBackgroundBrush" Color="#14C42B1C"/>

    <!-- Прочее -->
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="ControlPressedBackgroundBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#22000000"/>

</ResourceDictionary>
